HOST_NAME=prod-1
INGEST_URL=https://ingest.yourdomain.com
INGEST_USER=agent
INGEST_PASSWORD=SameAsHtpasswd
# Parent dir of Laravel apps (each has storage/logs/*.log)
LARAVEL_ROOT=/var/www

# --- Optional: run exporters for services in Docker. Leave a *_HOST empty to skip. ---
# Docker network your app containers share (docker network ls). Required if any *_HOST is set.
APP_NETWORK=
# Container (service) names as seen on that network
MYSQL_HOST=
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# Needs stub_status enabled in nginx, see README
NGINX_HOST=
