# =============================================================================
# Mailu application settings. Copy to `mailu.env` via scripts/bootstrap.sh.
# Read by every Mailu container. Change + `docker compose up -d` to apply.
# Reference: https://mailu.io/2024.06/configuration.html
# =============================================================================

# --- Secrets (generated by bootstrap.sh — never commit) ----------------------
SECRET_KEY=CHANGE_ME_16_BYTES
API_TOKEN=CHANGE_ME_LONG_RANDOM

# --- Identity ---------------------------------------------------------------
# DOMAIN is only the *technical* domain (bounces, postmaster). Every other
# domain you host is added later through the admin panel, not here.
# Do NOT use a special-use TLD (.local, .test, .internal): Mailu's web login
# validator rejects those addresses, though SMTP and the API accept them.
DOMAIN=example.com
# First hostname is the public MX / SMTP / IMAP name every domain points at.
HOSTNAMES=mail.brainchildsoft.com
POSTMASTER=admin
SITENAME=Mail
WEBSITE=https://mail.brainchildsoft.com
LOGO_BACKGROUND=
LOGO_URL=

# --- TLS --------------------------------------------------------------------
# cert        = we supply certs/cert.pem + certs/key.pem (host certbot or self-signed)
# letsencrypt = Mailu owns port 80/443 (NOT usable when host nginx owns them)
# notls       = testing only
TLS_FLAVOR=cert
TLS_CERT_FILENAME=cert.pem
TLS_KEYPAIR_FILENAME=key.pem
OUTBOUND_TLS_LEVEL=

# --- Ports the front container listens on -----------------------------------
# NOTE: Mailu's default omits 587 and 143. 587 is required for backend apps.
PORTS=25,80,443,465,587,993,4190

# --- Reverse proxy ----------------------------------------------------------
# Host nginx terminates TLS and forwards. REAL_IP_FROM must be set alongside
# REAL_IP_HEADER or an attacker can spoof their source IP.
# Leave REAL_IP_HEADER empty for local testing without a proxy in front.
# Traefik forwards the real client IP via X-Forwarded-For.
REAL_IP_HEADER=X-Forwarded-For
# Must match the `proxy` Docker network CIDR (check: docker network inspect proxy).
REAL_IP_FROM=172.0.0.0/8
# PROXY_PROTOCOL is mutually exclusive with REAL_IP_HEADER — leave unset.
PROXY_PROTOCOL=

# --- Feature toggles --------------------------------------------------------
ADMIN=true
API=true
WEBMAIL=roundcube
WEBDAV=none
ANTIVIRUS=none
FETCHMAIL_ENABLED=False
FETCHMAIL_DELAY=600
SCAN_MACROS=True
FULL_TEXT_SEARCH=en
DMARC_SEND_REPORTS=false

# --- Web paths --------------------------------------------------------------
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEB_API=/api
WEBROOT_REDIRECT=/sso/login
SITENAME_REDIRECT=

# --- Initial admin account (created on first start) --------------------------
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=example.com
INITIAL_ADMIN_PW=CHANGE_ME_ON_FIRST_LOGIN
INITIAL_ADMIN_MODE=ifmissing

# --- Quotas, limits, abuse prevention ---------------------------------------
MESSAGE_SIZE_LIMIT=50000000
MESSAGE_RATELIMIT=200/day
MESSAGE_RATELIMIT_EXEMPTION=
DEFAULT_QUOTA=1000000000
DEFAULT_SPAM_THRESHOLD=80
AUTH_RATELIMIT_IP=5/hour
AUTH_RATELIMIT_USER=50/day
AUTH_RATELIMIT_EXEMPTION=
AUTH_RATELIMIT_EXEMPTION_LENGTH=86400
AUTH_REQUIRE_TOKENS=False
RECIPIENT_DELIMITER=+
# Accounts allowed to send as ANY address — useful for one shared app sender.
WILDCARD_SENDERS=

# --- Outbound relay (only if the provider ever blocks port 25) ---------------
RELAYHOST=
RELAYUSER=
RELAYPASSWORD=
# DANGER: a wrong CIDR here makes an open relay. Prefer authenticated submission.
RELAYNETS=

# --- Sessions ---------------------------------------------------------------
# Set to False only for local http testing.
SESSION_COOKIE_SECURE=True
SESSION_TIMEOUT=3600
PERMANENT_SESSION_LIFETIME=108000

# --- Storage / performance --------------------------------------------------
COMPRESSION=
COMPRESSION_LEVEL=
# Uncomment on x86_64 with AVX2 (production VPS), leave off on Apple Silicon.
#LD_PRELOAD=/usr/lib/libhardened_malloc.so

# --- Redis (shared instance on bcs-net) -------------------------------------
# REDIS_PASSWORD must match the value in shared/.env
REDIS_ADDRESS=redis://:REDIS_PASSWORD_HERE@common-redis:6379/0

# --- Database (SQLite is the upstream recommendation) ------------------------
SQLALCHEMY_DATABASE_URI=sqlite:////data/main.db
SQLALCHEMY_DATABASE_URI_ROUNDCUBE=sqlite:////data/roundcube.db

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=WARNING
TZ=Etc/UTC
