# =============================================================================
# Compose-level settings. Copy to `.env` via scripts/bootstrap.sh.
# These control WHICH containers run and WHERE they are published.
# Application behaviour lives in mailu.env.
# =============================================================================

# --- Images -----------------------------------------------------------------
MAILU_VERSION=2024.06
DOCKER_ORG=ghcr.io/mailu
DOCKER_PREFIX=

# --- Storage ----------------------------------------------------------------
# LOCAL TEST: ./data      PRODUCTION VPS: /srv/mailu
MAILU_DATA_ROOT=./data
TZ=Etc/UTC

# --- Docker network ---------------------------------------------------------
# Must not clash with any network the VPS is attached to.
SUBNET=192.168.203.0/24
RESOLVER_IP=192.168.203.254

# --- Traefik ----------------------------------------------------------------
# Hostname Traefik routes to the web UI / admin / webmail.
MAIL_HOSTNAME=mail.example.com

# --- Published host addresses / ports ---------------------------------------
# LOCAL TEST: 127.0.0.1   PRODUCTION VPS: the server's public IPv4
BIND_ADDRESS4=127.0.0.1

# Mail protocol ports, published on BIND_ADDRESS4.
# LOCAL TEST uses high ports so nothing needs privileges or conflicts with macOS.
# PRODUCTION must be 25 / 465 / 587 / 993 / 4190.
SMTP_PORT=2525
SUBMISSIONS_PORT=4465
SUBMISSION_PORT=5587
IMAPS_PORT=9993
SIEVE_PORT=4190

# --- Optional containers (the master on/off switch) --------------------------
# Comma-separated. Remove a name and that container is simply never created.
#   webmail   Roundcube webmail for end users
#   webdav    Radicale CalDAV/CardDAV
#   fetchmail Pull mail from external accounts
#   antivirus ClamAV (adds ~1.5 GB RAM)
#   backup    Nightly encrypted restic backups
COMPOSE_PROFILES=webmail,backup

# --- Backup sidecar (profile: backup) ---------------------------------------
# Local repo by default. For offsite use e.g.
#   RESTIC_REPOSITORY=s3:s3.us-west-004.backblazeb2.com/my-bucket
#   AWS_ACCESS_KEY_ID=... / AWS_SECRET_ACCESS_KEY=...
RESTIC_REPOSITORY=/backups/restic
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_CRON="15 3 * * *"
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
